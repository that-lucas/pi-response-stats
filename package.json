  "bugs": {
    "url": "https://github.com/that-lucas/pi-response-stats/issues"
  },
  "scripts": {
    "test": "node --experimental-strip-types test-format.ts && node --test test-lifecycle.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "tps",
    "tokens-per-second",
